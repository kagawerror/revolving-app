# Copy to .env and fill in. Loaded at build time via --dart-define-from-file=.env
# NEVER commit the real .env — it is gitignored.

# Cloudinary (unsigned upload preset — the API SECRET is never used in the app)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
CLOUDINARY_UPLOAD_FOLDER=rev_app/proofs

# OneSignal (free push). App ID is public/safe in-app; the REST key lives ONLY in the relay.
ONESIGNAL_APP_ID=
# Cloudflare Worker relay URL + optional shared token
PUSH_RELAY_URL=
PUSH_RELAY_TOKEN=

# Admin relay Worker (Firebase Admin SDK behind it) for admin-set-password.
# When blank, the in-app "reset password" field is hidden (graceful degradation).
ADMIN_RELAY_URL=
