rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myCompany() { return myProfile().companyId; }
    function myRole() { return myProfile().role; }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function sameCompany(companyId) { return signedIn() && companyId == myCompany(); }
    function isIncharge() { return signedIn() && myRole() == 'incharge'; }
    function isApprover() {
      return signedIn() && (myRole() in ['superior', 'manager', 'ceo']);
    }

    // One-time bootstrap marker. Readable signed-out so the login screen can
    // offer first-time setup; creatable exactly once by the founding admin.
    match /meta/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/bootstrap)
        && request.resource.data.seeded == true
        && request.resource.data.seededByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admin maintenance: this `write` covers admin create/update/delete of any
      // profile doc, including creating a profile at an arbitrary (console-minted)
      // UID — required by the admin user console (no Cloud Functions on Spark).
      allow write: if isAdmin();
      // Owner self-service: a signed-in user may update ONLY their own
      // presentation/profile fields. role + companyId are admin-controlled and
      // must remain immutable on this path.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'photoUrl', 'themeMode', 'accentId'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.companyId == resource.data.companyId
        );
      // First-time setup: the founding user creates their own admin profile,
      // allowed only while the app has not been bootstrapped yet.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.companyId == ''
        && !exists(/databases/$(database)/documents/meta/bootstrap);
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /funds/{fundId} {
      allow read: if isAdmin() || sameCompany(resource.data.companyId);
      allow create: if isAdmin();
      // Two distinct paths:
      //  1) METADATA EDIT (first disjunct): an admin renaming a saved fund.
      //     name is the sole mutable field — companyId, budget, balance,
      //     threshold and status are all pinned immutable here (mirrors the
      //     name-only Edit-fund dialog: budget changes would move real money).
      //  2) OPERATIONAL (second disjunct): incharge releases and replenishment
      //     create/discard, approver replenishment approval (resets the
      //     balance), and admin acting as superuser. This path trusts the
      //     writer to mutate ANY fund field, including the balance — admin is
      //     trusted exactly the same way incharge/approver already are. That is
      //     safe because every money write goes through a runTransaction in the
      //     repos that re-reads and re-validates against current server state.
      allow update: if (isAdmin()
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.originalBudgetCentavos
              == resource.data.originalBudgetCentavos
          && request.resource.data.availableBalanceCentavos
              == resource.data.availableBalanceCentavos
          && request.resource.data.lowBalanceThresholdPct
              == resource.data.lowBalanceThresholdPct
          && request.resource.data.status == resource.data.status)
        || ((sameCompany(resource.data.companyId) || isAdmin())
          && (isIncharge() || isApprover() || isAdmin()));
      allow delete: if isAdmin();

      // Append-only audit trail (budgetAdjusted, etc.). Mirrors the request
      // history block. No amounts are exposed beyond the company scope.
      match /history/{eventId} {
        allow read: if isAdmin()
          || sameCompany(get(/databases/$(database)/documents/funds/$(fundId)).data.companyId);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /requests/{requestId} {
      allow read: if isAdmin() || sameCompany(resource.data.companyId);

      // Incharge creates; must belong to their company and carry a proof image.
      // Admin superuser may create in ANY company (non-empty companyId), still
      // owning the doc and attaching a proof image.
      allow create: if (isIncharge()
          && request.resource.data.companyId == myCompany()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.proofImageUrl is string
          && request.resource.data.proofImageUrl.size() > 0)
        || (isAdmin()
          && request.resource.data.companyId is string
          && request.resource.data.companyId.size() > 0
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.proofImageUrl is string
          && request.resource.data.proofImageUrl.size() > 0);

      // Approvers acknowledge/reject; incharge advances ready/released. Admin is
      // a superuser across companies, but the status-transition checks below stay
      // unchanged so admin still cannot make an illegal transition.
      allow update: if (sameCompany(resource.data.companyId) || isAdmin()) && (
        ((isApprover() || isAdmin())
          && resource.data.status == 'pendingAck'
          && request.resource.data.status in ['acknowledged', 'rejected'])
        || ((isIncharge() || isAdmin())
          && resource.data.status in ['acknowledged', 'readyForRelease']
          && request.resource.data.status in ['readyForRelease', 'released'])
        || ((isApprover() || isAdmin())
          && resource.data.status == 'released'
          && request.resource.data.status == 'replenished'
          && request.resource.data.replenishmentId is string)
      );

      allow delete: if false;

      match /history/{eventId} {
        allow read: if sameCompany(get(/databases/$(database)/documents/requests/$(requestId)).data.companyId);
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /replenishments/{repId} {
      allow read: if isAdmin() || sameCompany(resource.data.companyId);
      // Incharge creates in their own company; admin superuser in any company.
      allow create: if (isIncharge()
          && request.resource.data.companyId == myCompany()
          && request.resource.data.status == 'draft')
        || (isAdmin()
          && request.resource.data.companyId is string
          && request.resource.data.companyId.size() > 0
          && request.resource.data.status == 'draft');
      // Admin superuser may act across companies; the status-transition checks
      // stay unchanged so admin cannot make an illegal transition.
      allow update: if (sameCompany(resource.data.companyId) || isAdmin()) && (
        ((isIncharge() || isAdmin())
          && resource.data.status == 'draft'
          && request.resource.data.status in ['draft', 'submitted', 'rejected'])
        || ((isApprover() || isAdmin())
          && resource.data.status == 'submitted'
          && request.resource.data.status in ['approved', 'rejected'])
      );
      allow delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if sameCompany(resource.data.companyId)
        && (myRole() in resource.data.recipientRoles);
      // Admin's post-commit notif writes target other companies (admin
      // myCompany()==''), so allow them explicitly.
      allow create: if sameCompany(request.resource.data.companyId) || isAdmin();
      allow update: if (sameCompany(resource.data.companyId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }
  }
}
